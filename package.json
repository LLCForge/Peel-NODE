{
  "name": "peel-js",
  "version": "0.1.0",
  "description": "Open-source JavaScript deobfuscator that runs in your browser. Your code never leaves your device.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "peel": "bin/peel.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LLCForge/Peel-JS.git"
  },
  "homepage": "https://github.com/LLCForge/Peel-JS#readme",
  "bugs": {
    "url": "https://github.com/LLCForge/Peel-JS/issues"
  },
  "keywords": [
    "deobfuscator",
    "javascript",
    "obfuscator.io",
    "js-confuser",
    "reverse-engineering",
    "malware-analysis",
    "security",
    "quickjs",
    "babel"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node test/run.js && node test/all.js",
    "bench": "node test/bench.js",
    "sbom": "node scripts/sbom.js --prod -o peel-sbom.cdx.json",
    "build:lib": "vite build -c vite.lib.config.js"
  },
  "dependencies": {
    "@babel/generator": "^7.26.0",
    "@babel/parser": "^7.26.0",
    "@babel/traverse": "^7.26.0",
    "@babel/types": "^7.26.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "1.2.5",
    "brotli": "1.3.3",
    "@mlc-ai/web-llm": "0.2.86",
    "prettier": "^3.4.0",
    "quickjs-emscripten": "^0.31.0"
  },
  "devDependencies": {
    "javascript-obfuscator": "^5.10.0",
    "js-confuser": "^2.1.3",
    "vite": "^6.0.0"
  },
  "optionalDependencies": {
    "z3-solver": "5.4.1"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./node": {
      "types": "./src/node.d.ts",
      "default": "./src/node.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "extensions/semgrep/",
    "README.md",
    "README.tr.md",
    "LICENSE"
  ]
}
